{
  "name": "mdl-relay",
  "version": "1.0.0",
  "private": true,
  "description": "MusicDL 的 Cloudflare Worker 中继：给 GitHub Pages 静态前端提供无服务器后端",
  "main": "worker.js",
  "scripts": {
    "deploy": "wrangler deploy worker.js --name mdl-relay --compatibility-date 2024-11-01",
